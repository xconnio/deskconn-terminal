{
  "name": "deskconn-terminal",
  "productName": "DeskConn Terminal",
  "version": "0.1.0",
  "description": "Standalone DeskConn terminal",
  "author": "XConnIO",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "run-p -r vite:dev \"start -- --dev-url=http://localhost:5174\"",
    "vite:dev": "vite",
    "build": "npm run type-check && vite build",
    "type-check": "vue-tsc -p tsconfig.json",
    "start": "electron .",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.2",
    "deskconn-web-app": "github:xconnio/deskconn-web#8535bb13a9033e5a1ed790fd602340a8bb6ad187",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "npmRebuild": false,
    "appId": "io.xconn.deskconn.terminal",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/resources/icon.png",
      "!node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "System",
      "icon": "electron/resources/icon.png",
      "executableName": "deskconn-terminal",
      "maintainer": "XConnIO <info@xconn.io>",
      "syncDesktopName": true
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "deb": {
      "packageName": "deskconn-terminal"
    },
    "artifactName": "deskconn-terminal-${version}-${os}-${arch}.${ext}"
  }
}
